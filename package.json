{
  "name": "arthur-meimei",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "start": "concurrently -k -n content,next -c yellow,cyan \"contentlayer2 dev\" \"next dev --turbopack\"",
    "dev": "concurrently -k -n content,next -c yellow,cyan \"contentlayer2 dev\" \"cross-env INIT_CWD=$PWD next dev\"",
    "build": "contentlayer2 build && cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "contentlayer2 build && cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@next/bundle-analyzer": "16.2.9",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.1",
    "@tailwindcss/typography": "0.5.20",
    "body-scroll-lock": "4.0.0-beta.0",
    "contentlayer2": "0.5.8",
    "esbuild": "0.28.1",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-from-html-isomorphic": "2.0.0",
    "image-size": "2.0.2",
    "katex": "0.17.0",
    "next": "16.2.9",
    "next-contentlayer2": "0.5.8",
    "next-themes": "0.4.6",
    "pliny": "0.4.1",
    "postcss": "8.5.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-citation": "2.3.2",
    "rehype-katex": "7.0.1",
    "rehype-katex-notranslate": "1.1.4",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "6.0.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.24.0",
    "@svgr/webpack": "8.1.0",
    "@types/mdx": "2.0.14",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "concurrently": "10.0.3",
    "cross-env": "10.1.0",
    "eslint": "9.24.0",
    "eslint-config-next": "15.5.18",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.14.2",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@<1.14.4": ">=1.14.4"
    }
  }
}
