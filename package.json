{
  "name": "arthur-meimei",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "start": "concurrently -k -n content,next -c yellow,cyan \"contentlayer2 dev\" \"next dev --turbopack\"",
    "dev": "concurrently -k -n content,next -c yellow,cyan \"contentlayer2 dev\" \"cross-env INIT_CWD=$PWD next dev\"",
    "build": "contentlayer2 build && cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "contentlayer2 build && cross-env ANALYZE=true next build",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "vitest run"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@next/bundle-analyzer": "16.3.2",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "body-scroll-lock": "4.0.0-beta.0",
    "chess.js": "1.4.0",
    "clsx": "2.1.1",
    "contentlayer2": "0.5.8",
    "esbuild": "0.28.2",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-from-html-isomorphic": "2.0.0",
    "image-size": "2.0.2",
    "js-chess-engine": "2.4.6",
    "katex": "0.18.4",
    "lucide-react": "1.17.0",
    "next": "16.3.2",
    "next-contentlayer2": "0.5.8",
    "next-themes": "0.4.6",
    "pliny": "0.4.1",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-chessboard": "5.12.1",
    "react-dom": "19.2.8",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-citation": "2.3.2",
    "rehype-katex": "7.0.1",
    "rehype-katex-notranslate": "1.1.4",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "6.0.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.24.0",
    "@svgr/webpack": "8.1.0",
    "@types/mdx": "2.0.14",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "eslint": "9.24.0",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.14.2",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@<1.14.4": ">=1.14.4",
      "uuid@9.0.1": "11.1.1",
      "qs@6.15.1": "6.15.2",
      "postcss@8.4.31": "8.5.15",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "protobufjs@<7.6.5": "7.6.5",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "svgo@>=3.0.0 <3.3.4": "3.3.4",
      "form-data@<2.5.6": "2.5.6",
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=3.0.0 <5.0.7": "5.0.7",
      "@babel/core@<7.29.6": "7.29.6"
    }
  }
}
